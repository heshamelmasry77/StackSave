# Copy to .env for local development (git-ignored). Everything here has a working local default,
# so `.env` is only needed to override something, e.g. to test Google sign-in.

# PORT=3000
# APP_URL=http://localhost:3000

# From `npm run services:up` (docker-compose.yml)
# DATABASE_URL=postgres://stacksave:stacksave@localhost:54329/stacksave

# Required in production: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Google sign-in. Authorised redirect URI: <APP_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Magic-link email. Unset locally = links are printed in the server console.
# To use the local Mailpit inbox (http://localhost:8026) instead:
# SMTP_URL=smtp://localhost:1026
# MAIL_FROM=SlackSave <login@stacksave.local>
